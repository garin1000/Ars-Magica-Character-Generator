{
  "name": "arm-char-gen-ui",
  "private": true,
  "version": "0.3.0",
  "description": "Svelte 5 frontend for the Ars Magica 5th Edition Character Generator",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/garin1000/Ars-Magica-Character-Generator.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "svelte-check --tsconfig ./tsconfig.json && vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "wdio run ./e2e/wdio.conf.js",
    "test:e2e:portable": "wdio run ./e2e/wdio.portable.conf.js"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tsconfig/svelte": "^5.0.4",
    "@wdio/cli": "^9.2.0",
    "@wdio/local-runner": "^9.2.0",
    "@wdio/mocha-framework": "^9.2.0",
    "@wdio/spec-reporter": "^9.2.0",
    "eslint": "^9.13.0",
    "eslint-plugin-svelte": "^2.46.0",
    "globals": "^15.11.0",
    "happy-dom": "^20.11.6",
    "prettier": "^3.3.3",
    "prettier-plugin-svelte": "^3.2.7",
    "svelte": "^5.1.0",
    "svelte-check": "^4.0.5",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.12.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "@fluent/bundle": "^0.18.0",
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.0.0"
  }
}
